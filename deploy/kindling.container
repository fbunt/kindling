# Quadlet unit (rootless user service) — the production form for Fedora CoreOS /
# Silverblue / a podman-equipped GCP VM. Install to:
#   ~/.config/containers/systemd/kindling.container
# then:  systemctl --user daemon-reload && systemctl --user start kindling
#
# Prereqs on the host:
#   - systemctl --user enable --now podman.socket
#   - loginctl enable-linger $USER   (rootless user services start at boot and
#     survive logout; without it the unit only runs while a session is open)
#   - the worker image in the user's image store (podman build -t kindling-worker:latest .)
#   - the app image (podman build -t kindling-app:latest -f Containerfile.app .)
#   - podman secret create kindling-gemini-key <file-with-key>   (or drop the Secret line)
#   - edit the parquet paths below to the real host path
[Unit]
Description=kindling natural-language query app
# The app drives the host runtime through the user socket; start after it
# rather than racing it at boot and coming up with an empty worker pool. If
# the socket unit is missing, the dependency fails and the app is not started.
Requires=podman.socket
After=network-online.target podman.socket
# SandboxPool.start() exits non-zero (in ~1-2 s) when no worker comes up, e.g.
# the worker image is missing or KINDLING_WORKER_PARQUET_PATH is wrong. With
# systemd's default start limit (5 starts / 10 s) that would mark the unit
# `failed` after ~7 s and stop retrying; disable the limit so Restart= below
# keeps retrying until the misconfiguration is fixed.
StartLimitIntervalSec=0

[Container]
Image=kindling-app:latest
Exec=kindling /data/dataset.parquet --host 0.0.0.0
# Loopback only: reach it via an SSH tunnel (ssh -N -L 8000:localhost:8000 user@host)
# or IAP. Change to 0.0.0.0:8000:8000 only if you deliberately want it on the network.
PublishPort=127.0.0.1:8000:8000
# %t = the user's XDG_RUNTIME_DIR (where the rootless podman socket lives).
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Volume=/srv/kindling/data/mtbs.parquet:/data/dataset.parquet:ro
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Environment=KINDLING_WORKER_PARQUET_PATH=/srv/kindling/data/mtbs.parquet
Environment=KINDLING_SANDBOX_IMAGE=kindling-worker:latest
# Reap a crashed predecessor's leftover kindling-worker-* containers on start
# (one app instance per host here, so the family-wide sweep is safe).
Environment=KINDLING_REAP_ORPHANS=all
# 'true' -> Vertex AI express mode (the AQ.… key only works on Vertex); unset
# for the Gemini Developer API. Must match the kind of key in the secret below.
Environment=KINDLING_USE_VERTEX=false
Environment=PYTHONUNBUFFERED=1
Secret=kindling-gemini-key,type=env,target=GEMINI_API_KEY
SecurityLabelDisable=true

[Service]
Restart=always
# Pace the retries (default 100 ms) so a persistent startup failure is a
# slow, readable loop in the journal instead of a tight one.
RestartSec=5

[Install]
WantedBy=default.target
